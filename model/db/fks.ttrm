package hartland

model db schema hartland

// Every foreign key of data/ddl/schema.sql, by source table in the inventory's order (205; imported at M0 S0.1 T3).
// In the database each is DEFERRABLE INITIALLY DEFERRED (contracts §1: the load copies in load_order, and a
// document's references interleave the groups); TTR-M has no deferrable flag, so it is said here. The names
// are the database's constraint names.

// -- okres --
def fk okres_kraj_id_fkey         { from: [db.hartland.okres.kraj_id], to: [db.hartland.kraj.kraj_id] }
def fk okres_parent_okres_id_fkey { from: [db.hartland.okres.parent_okres_id], to: [db.hartland.okres.okres_id] }

