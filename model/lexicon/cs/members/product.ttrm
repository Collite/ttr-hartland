package hartland

model lexicon locale cs

// The product word list — seeded by scripts/seed_members.py from data/reference/product.csv (name_cs, nicknames_cs)
// (M0 S0.1 T5). Do not edit: edit the sources and re-seed. One term per member, its words in `forms`; `for:` is the
// member vocabulary's column until M3 S3.1 T5 re-targets each term to its member (README.md).

def term product_classic_cs {
    description: "Harcafé Classic (CLASSIC)"
    for: db.hartland.product.name
    forms: ["Harcafé Classic", "klasik", "klasika"]
}

