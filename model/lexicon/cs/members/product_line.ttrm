package hartland

model lexicon locale cs

// The product_line word list — seeded by scripts/seed_members.py from data/reference/product_line.csv (name_cs) (M0
// S0.1 T5). Do not edit: edit the sources and re-seed. One term per member, its words in `forms`; `for:` is the
// member vocabulary's column until M3 S3.1 T5 re-targets each term to its member (README.md).

def term product_line_classic_cs {
    description: "Harcafé Classic (CLASSIC)"
    for: db.hartland.product_line.name
    forms: ["Classic"]
}

def term product_line_gold_cs {
    description: "Harcafé Gold (GOLD)"
    for: db.hartland.product_line.name
    forms: ["Gold"]
}

