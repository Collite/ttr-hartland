package hartland

model lexicon locale cs

// The kraj word list — seeded by scripts/seed_members.py from data/reference/kraj.csv + declension.csv (nominative,
// genitive, locative) (M0 S0.1 T5). Do not edit: edit the sources and re-seed. One term per member, its words in
// `forms`; `for:` is the member vocabulary's column until M3 S3.1 T5 re-targets each term to its member
// (README.md).

def term kraj_cz010_cs {
    description: "Hlavní město Praha (CZ010)"
    for: db.hartland.kraj.name
    forms: ["Hlavní město Praha", "Hlavního města Prahy", "Hlavním městě Praze"]
}

