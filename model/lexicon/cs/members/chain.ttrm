package hartland

model lexicon locale cs

// The chain word list — seeded by scripts/seed_members.py from the store classifier's chains
// (hartland_sim.setup.classifier.chains) and their sub-brands (M0 S0.1 T5). Do not edit: edit the sources and re-
// seed. One term per member, its words in `forms`; `for:` is the member vocabulary's column until M3 S3.1 T5 re-
// targets each term to its member (README.md).

def term chain_tesco_cs {
    description: "Tesco (TESCO)"
    for: db.hartland.chain.name
    forms: ["Tesco"]
}

