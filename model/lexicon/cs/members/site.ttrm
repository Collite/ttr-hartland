package hartland

model lexicon locale cs

// The site word list — seeded by scripts/seed_members.py from data/reference/site.csv (name; a DC's town) (M0 S0.1
// T5). Do not edit: edit the sources and re-seed. One term per member, its words in `forms`; `for:` is the member
// vocabulary's column until M3 S3.1 T5 re-targets each term to its member (README.md).

def term site_hq_praha_cs {
    description: "Centrála Praha (HQ-PRAHA)"
    for: db.hartland.site.name
    forms: ["Centrála Praha"]
}

