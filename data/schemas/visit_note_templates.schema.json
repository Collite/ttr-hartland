{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Collite/ttr-hartland/data/schemas/visit_note_templates.schema.json",
  "title": "reference/visit_note_templates.yaml — the sentences of the reps' visit notes (G2 S2.1 T6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slots",
    "outcomes",
    "situations",
    "objections"
  ],
  "properties": {
    "slots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+$"
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "no_order",
        "closed",
        "refused",
        "not_found"
      ],
      "properties": {
        "order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "no_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "closed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "refused": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_found": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "situations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "objections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
