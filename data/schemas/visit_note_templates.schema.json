{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Collite/ttr-hartland/data/schemas/visit_note_templates.schema.json",
  "title": "reference/visit_note_templates.yaml — the sentences of the reps' visit notes (G2 S2.1 T6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slots",
    "outcomes",
    "no_order_by_kind",
    "situations",
    "objections"
  ],
  "properties": {
    "slots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+$"
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "no_order",
        "closed",
        "refused",
        "not_found"
      ],
      "properties": {
        "order": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "no_order": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "closed": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "refused": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_found": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "no_order_by_kind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition",
        "merchandising"
      ],
      "properties": {
        "acquisition": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "merchandising": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "situations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_executed",
        "promotion_missing",
        "out_of_stock",
        "competitor_promotion",
        "competitor_listing",
        "competitor_display",
        "competitor_price_cut",
        "display",
        "listing",
        "listing_taken"
      ],
      "properties": {
        "promotion_executed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "promotion_missing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_stock": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "competitor_promotion": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "competitor_listing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "competitor_display": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "competitor_price_cut": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "display": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "listing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "listing_taken": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "objections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
