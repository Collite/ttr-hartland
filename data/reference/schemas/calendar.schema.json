{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Collite/ttr-hartland/data/reference/schemas/calendar.schema.json",
  "title": "calendar.csv — one row per day, 2023-01-01 → 2027-12-31",
  "description": "Generated by hartland_sim.setup.calendar; a test fails when the file and the rules differ.",
  "x-rows": [
    1826,
    1826
  ],
  "x-key": [
    "day"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "day",
    "year",
    "quarter",
    "month",
    "week",
    "iso_year",
    "weekday",
    "weekday_cs",
    "is_working_day",
    "holiday_cs",
    "season"
  ],
  "properties": {
    "day": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "year": {
      "type": "integer",
      "minimum": 2023
    },
    "quarter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 53,
      "description": "ISO week"
    },
    "iso_year": {
      "type": "integer",
      "description": "the ISO week's year"
    },
    "weekday": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "description": "ISO: 1 = Monday"
    },
    "weekday_cs": {
      "enum": [
        "pondělí",
        "úterý",
        "středa",
        "čtvrtek",
        "pátek",
        "sobota",
        "neděle"
      ],
      "x-czech": true
    },
    "is_working_day": {
      "type": "boolean"
    },
    "holiday_cs": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "x-czech": true,
      "description": "one of the thirteen days off of zákon č. 245/2000 Sb."
    },
    "season": {
      "enum": [
        "zima",
        "jaro",
        "léto",
        "podzim"
      ],
      "x-czech": true
    }
  }
}
