{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Collite/ttr-hartland/data/reference/schemas/brand.schema.json",
  "title": "brand.csv — the two brands and their businesses (01 §3, ⚑NH-4)",
  "x-rows": [
    2,
    2
  ],
  "x-key": [
    "code"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "name",
    "business",
    "business_name"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "x-czech": true
    },
    "business": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "business_name": {
      "type": "string",
      "minLength": 1,
      "x-czech": true
    }
  }
}
