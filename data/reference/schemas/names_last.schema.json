{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Collite/ttr-hartland/data/reference/schemas/names_last.schema.json",
  "title": "names_last.csv — Czech surnames, male and female forms",
  "x-rows": [
    50,
    200
  ],
  "x-key": [
    "male"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "male",
    "female"
  ],
  "properties": {
    "male": {
      "type": "string",
      "minLength": 1,
      "x-czech": true
    },
    "female": {
      "type": "string",
      "minLength": 1,
      "x-czech": true
    }
  }
}
