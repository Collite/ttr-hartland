{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Collite/ttr-hartland/data/reference/schemas/wage_by_kraj.schema.json",
  "title": "wage_by_kraj.csv — ČSÚ average gross monthly wage per kraj and for Česko (SOURCES.md)",
  "x-rows": [
    15,
    15
  ],
  "x-key": [
    "code"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "name",
    "wage_czk",
    "year"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^CZ(0[0-9]{2})?$",
      "description": "a kraj code, or CZ for Česko"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "x-czech": true
    },
    "wage_czk": {
      "type": "integer",
      "minimum": 20000,
      "maximum": 150000
    },
    "year": {
      "type": "integer",
      "minimum": 2023
    }
  }
}
