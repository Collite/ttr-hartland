{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Collite/ttr-hartland/data/reference/schemas/weather_normals.schema.json",
  "title": "weather_normals.csv — per region × month: the climate weather_daily is drawn from",
  "x-rows": [
    72,
    72
  ],
  "x-key": [
    "region",
    "month"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "region",
    "month",
    "temp_mean_c",
    "temp_sd_c",
    "precip_month_mm",
    "wet_days"
  ],
  "properties": {
    "region": {
      "type": "string",
      "x-ref": "region.code"
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "temp_mean_c": {
      "type": "number",
      "minimum": -15,
      "maximum": 30
    },
    "temp_sd_c": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10,
      "description": "of the daily mean"
    },
    "precip_month_mm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "wet_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31,
      "description": "days with ≥ 1 mm"
    }
  }
}
